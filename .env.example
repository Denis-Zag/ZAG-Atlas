PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
LLM_MODEL=openai/gpt-5-mini
LLM_REASONING_EFFORT=low
LLM_MAX_COMPLETION_TOKENS=4000
LLM_TIMEOUT=90
# Только для первоначального создания admin; затем пароль меняется на сайте.
ADMIN_PASSWORD=
PDF_MAX_PAGES=100
OCR_MAX_PAGES=10
OCR_PAGE_TIMEOUT=30
LLM_CONNECT_TIMEOUT=10

# В Compose включён hybrid; без Compose по умолчанию lexical.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_MIN_SCORE=0.25

# Уровень технических JSON-логов: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# При серверном HTTPS-развёртывании установить true.
SESSION_COOKIE_SECURE=false
